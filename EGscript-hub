<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EG-Script Hub & Live Studio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes rgbGradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        @keyframes ribbonPan {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .animated-rgb-bg {
            background: linear-gradient(135deg, #ff0000, #ff7f00, #ffff00, #7fff00, #00ff00, #00ff7f, #00ffff, #007fff, #0000ff, #7f00ff, #ff00ff, #ff007f);
            background-size: 400% 400%;
            animation: rgbGradientShift 12s ease infinite;
        }
        .panning-ribbon {
            background: linear-gradient(270deg, rgba(6, 182, 212, 0.4), rgba(16, 185, 129, 0.4), rgba(59, 130, 246, 0.4), rgba(168, 85, 247, 0.4));
            background-size: 300% 300%;
            animation: ribbonPan 8s ease infinite;
        }
    </style>
</head>
<body class="animated-rgb-bg text-slate-100 min-h-screen flex flex-col justify-between font-sans">
<header class="bg-slate-950/85 backdrop-blur-md border-b border-white/20 p-4 sticky top-0 z-50 shadow-2xl relative overflow-hidden">
       
        <div class="absolute inset-x-0 bottom-0 h-[3px] panning-ribbon"></div>
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white font-mono font-bold text-base shadow-lg border border-cyan-400/50">
                    EG
                </div>
                <span class="text-sm font-mono font-extrabold tracking-widest text-cyan-300 uppercase drop-shadow-sm">EG-Script Official Hub</span>
            </div>
            <h1 class="text-xs sm:text-sm font-black tracking-widest text-white font-mono hidden md:block drop-shadow">
                DEVELOPED BY GOUTHAM MOHAN
            </h1>
            <div class="flex items-center gap-3">
               <button onclick="downloadEgscriptApp()" class="text-xs font-mono bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 px-3 py-1.5 rounded-lg hover:bg-emerald-500/30 transition-all shadow-md cursor-pointer flex items-center gap-1.5 font-bold">
                    <span>📥</span> Download Code (.html)
                </button>
                <div class="text-xs font-mono bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 px-3 py-1.5 rounded-lg shadow-md tracking-wider">
                    ⚡ STUDIO V2.0
                </div>
            </div>
        </div>
    </header>
 <main class="container mx-auto p-4 md:p-6 flex-grow max-w-5xl flex items-center justify-center my-auto">
        <div class="w-full bg-slate-900/90 backdrop-blur-2xl rounded-3xl p-6 border border-white/25 shadow-2xl flex flex-col gap-4 relative overflow-hidden">
            <!-- Top Panning Ribbon Glow -->
            <div class="absolute top-0 inset-x-0 h-1 panning-ribbon"></div>
            
            <div class="flex justify-between items-center px-2 pt-2">
                <span class="text-xs font-mono text-cyan-300 font-extrabold uppercase tracking-widest flex items-center gap-2">
                    <span>⚡</span> Live App Floating Studio Frame
                </span>
                <span class="text-[10px] font-mono text-emerald-400 font-semibold bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-1 rounded-full">Environment Ready</span>
            </div>
            <div class="rounded-2xl overflow-hidden border border-white/15 bg-slate-950 shadow-inner">
                <iframe src="Gscript-pro.html" class="w-full h-[550px] border-0"></iframe>
            </div>
        </div>

    </main>
<footer class="bg-slate-950/85 backdrop-blur-md border-t border-white/10 py-4 text-center text-xs font-mono text-slate-400 relative overflow-hidden">
        <div class="absolute inset-x-0 top-0 h-[2px] panning-ribbon"></div>
        EG-Script Studio Hub &bull; Developed by Goutham Mohan
    </footer>
<script>
        function downloadEgscriptApp() {
            const egscriptCode = `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Egscript (enhanced general script) Pro Live PDF Engine - Studio Edition</title>
    <script src="https://cdn.tailwindcss.com"><\/script>
    <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"><\/script>
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"><\/script>
    <style>
        @keyframes gradientShift {            0% { background-position: 0% 50%; }            50% { background-position: 100% 50%; }            100% { background-position: 0% 50%; }        }
        .animated-bg {            background: linear-gradient(-45deg, #f8fafc, #e0f2fe, #dcfce7, #f3e8ff, #fdf4ff,#003300,#00ffff,#ff0066,#00ffbf);            background-size: 400% 400%;            animation: gradientShift 10s ease infinite;        }
        @keyframes subtle-glow {            0%, 100% { box-shadow: 0 0 4px rgba(16, 185, 129, 0.2); }            50% { box-shadow: 0 0 12px rgba(16, 185, 129, 0.5); }        }
        .terminal-glow:focus { animation: subtle-glow 1s infinite; }
        .preview-container iframe { width: 100%; height: 550px; border-radius: 8px; border: 1px solid #cbd5e1; background: white;}
    </style>
</head>
<body class="animated-bg text-slate-800 min-h-screen flex flex-col justify-between font-sans">
    <header class="bg-white/70 backdrop-blur-md border-b border-white/50 p-4 sticky top-0 z-50 shadow-sm">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex items-center gap-3">
                <span class="text-xs font-mono text-slate-500 hidden sm:block font-semibold">Engine Concept by Goutham Mohan</span>
            </div>
            <div class="flex items-center gap-2.5 group cursor-pointer">
                <div class="flex flex-col text-right">
                    <span class="text-sm font-bold tracking-wider text-slate-800 font-mono flex items-center justify-end gap-1">
                        EG<span class="text-emerald-600">.script</span>
                    </span>
                    <span class="text-[9px] font-mono text-slate-400 tracking-widest uppercase font-semibold">Studio Engine</span>
                </div>
                <div class="h-8 w-8 rounded-lg bg-gradient-to-br from-emerald-500 to-teal-700 flex items-center justify-center text-white font-mono font-bold text-sm shadow-md shadow-emerald-500/20">
                    &lt;/&gt;
                </div>
            </div>
        </div>
    </header>
    <main class="container mx-auto p-4 md:p-6 flex-grow max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <div class="lg:col-span-4 flex flex-col gap-5">
                <div class="bg-white/80 backdrop-blur-sm rounded-xl p-5 border border-white flex flex-col gap-4 shadow-lg">
                    <h2 class="text-xs font-mono font-bold tracking-widest text-emerald-600 uppercase border-b border-slate-100 pb-2 flex items-center gap-2">
                        <span>⚙️</span> ENGINE & MAIN FILE
                    </h2>
                    <div>
                        <label class="block text-[11px] font-mono tracking-wider uppercase text-slate-500 mb-1 font-semibold">Target Document Payload (Main PDF)</label>
                        <input type="file" id="pdfUpload" accept="application/pdf" class="w-full text-xs text-slate-600 file:mr-3 file:py-1 file:px-2.5 file:rounded file:border-0 file:bg-emerald-600/10 file:text-emerald-700 hover:file:bg-emerald-600/20 cursor-pointer bg-slate-50/50 p-1.5 border border-slate-200 rounded transition-all" />
                    </div>
                </div>
            </div>
            <div class="lg:col-span-8 flex flex-col gap-6">
                <div class="bg-white/80 backdrop-blur-sm rounded-xl p-5 border border-white shadow-lg flex flex-col gap-4">
                    <div class="flex justify-between items-center">
                        <label for="scriptBox" class="block text-xs font-mono font-bold tracking-widest uppercase text-slate-600">Egscript Command Terminal</label>
                        <span class="text-[10px] font-mono bg-slate-100 border border-slate-200 px-2 py-0.5 rounded text-slate-500 font-semibold">Separator: [ ; ]</span>
                    </div>
                    <textarea id="scriptBox" rows="6" class="terminal-glow w-full bg-slate-900 border border-slate-800 rounded-lg p-3 font-mono text-xs sm:text-sm text-emerald-400 focus:outline-none focus:border-emerald-500 transition-all leading-relaxed shadow-inner" placeholder='/gedit:add_page_numbers;&#10;/gedit:protect-1-5;&#10;/gedit:spellcheck;'></textarea>
                    <div class="flex flex-wrap gap-4 items-center justify-between pt-2 border-t border-slate-100">
                        <button id="runScriptBtn" class="bg-emerald-600 hover:bg-emerald-500 text-white font-mono font-semibold text-xs px-5 py-2.5 rounded-md transition-all active:scale-95 cursor-pointer shadow-md">
                            ⚡ COMPILE & EXECUTE
                        </button>
                        <button id="downloadPdfBtn" disabled class="bg-blue-600 disabled:bg-slate-200 disabled:text-slate-400 disabled:cursor-not-allowed hover:bg-blue-500 text-white font-mono font-semibold text-xs px-5 py-2.5 rounded-md transition-all flex items-center gap-2 shadow-md cursor-pointer">downlode</button>
                    </div>
                    <div>
                        <span class="text-[10px] font-mono uppercase text-slate-400 tracking-widest block mb-1 font-semibold">Live Diagnostic Terminal Outputs</span>
                        <div id="consoleLog" class="p-2.5 bg-white rounded-lg border border-slate-200 text-xs font-mono text-slate-600 h-24 overflow-y-auto shadow-inner">
                            > Welcome to the Studio! Engine standing by...
                        </div>
                    </div>
                </div>
                <div class="bg-white/80 backdrop-blur-sm rounded-xl p-5 border border-white shadow-lg flex flex-col gap-3">
                    <h3 class="text-xs font-mono font-bold tracking-widest uppercase text-slate-600">👁️ Real-Time Dynamic Document Preview</h3>
                    <div id="previewWrapper" class="preview-container bg-slate-50/50 rounded-lg flex items-center justify-center text-xs font-mono text-slate-400 p-8 text-center min-h-[250px]">
                        Preview will load here dynamically.
                    </div>
                </div>
            </div>
        </div>
    </main>
    <script>
        let uploadedPdfBytes = null, modifiedPdfBytes = null;
        const log = (msg, isError = false) => {
            const consoleLog = document.getElementById('consoleLog');
            const style = isError ? 'text-red-500 font-bold' : 'text-emerald-600';
            consoleLog.innerHTML += \`<br><span class="\${style}">> \${msg}</span>\`;
            consoleLog.scrollTop = consoleLog.scrollHeight;
        };
        const updateLivePreview = (pdfBytesArray) => {
            const wrapper = document.getElementById('previewWrapper');
            const blob = new Blob([pdfBytesArray], { type: 'application/pdf' });
            wrapper.innerHTML = \`<iframe src="\${URL.createObjectURL(blob)}#toolbar=0&navpanes=0"></iframe>\`;
        };
        document.getElementById('pdfUpload').addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (file) {
                uploadedPdfBytes = await file.arrayBuffer();
                log(\`Main PDF loaded: \${file.name}\`);
                updateLivePreview(uploadedPdfBytes);
            }
        });
        document.getElementById('runScriptBtn').addEventListener('click', async () => {
            if (!uploadedPdfBytes) return log('Error: Main PDF missing.', true);
            const rawScript = document.getElementById('scriptBox').value.trim();
            try {
                log('Initiating compiler...');
                const pdfDoc = await PDFLib.PDFDocument.load(uploadedPdfBytes);
                const commands = rawScript.split(';');
                for (let cmd of commands) {
                    cmd = cmd.trim();
                    if (!cmd) continue;
                    if (cmd.startsWith('/gedit:add_page_numbers')) {
                        const pages = pdfDoc.getPages();
                        const font = await pdfDoc.embedFont(PDFLib.StandardFonts.Helvetica);
                        pages.forEach((page, idx) => {
                            page.drawText(\`Page \${idx + 1}\`, { x: page.getSize().width / 2 - 20, y: 20, size: 10, font, color: PDFLib.rgb(0.4, 0.4, 0.4) });
                        });
                        log("🔢 Auto Page Numbers applied.");
                    }
                }
                modifiedPdfBytes = await pdfDoc.save();
                log('✨ COMPILATION SUCCESSFUL.');
                updateLivePreview(modifiedPdfBytes);
                document.getElementById('downloadPdfBtn').disabled = false;
            } catch (err) {
                log(\`Pipeline Error: \${err.message}\`, true);
            }
        });
        document.getElementById('downloadPdfBtn').addEventListener('click', () => {
            if (!modifiedPdfBytes) return;
            const blob = new Blob([modifiedPdfBytes], { type: 'application/pdf' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'gscript_studio_output.pdf';
            link.click();
            log('Export downloaded successfully.');
        });
    <\/script>
</body>
</html>`;

            const blob = new Blob([egscriptCode], { type: 'text/html' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'Gscript-pro.html';
            a.click();
            URL.revokeObjectURL(url);
        }
    </script>
</body>
</html>
